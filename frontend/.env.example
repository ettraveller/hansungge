# =====================================================================
# 프론트엔드 환경변수 템플릿
#
#   cp .env.example .env.development.local
#
# ⚠️ .env.local 이 아니라 <b>.env.development.local</b> 이다.
#
# Next 의 우선순위에서 .env.local 은 test 를 뺀 <b>모든 환경</b>에서 .env.production
# 보다 앞선다. 즉 개발용 localhost 주소가 <b>운영 빌드에까지 박힌다.</b>
# 그러면 배포는 성공하고 화면도 뜨는데, 브라우저가 localhost:8080 을 부르다
# CORS 로 막혀 로그인만 안 되는 상태가 된다 — 실제로 한 번 냈던 사고다.
#
# .env.development.local 은 NODE_ENV=development 일 때만 읽히므로 그 일이 없다.
#
# 실제 값이 담긴 .env.development.local 은 .gitignore 대상이다.
# 무엇이 필요한지는 커밋하고, 값은 커밋하지 않는다.
# =====================================================================

# 브라우저가 직접 부를 백엔드 주소.
#
# 목록·상세 같은 공개 데이터는 서버 컴포넌트가 백엔드를 직접 부르므로 이 값을 쓰지
# 않는다(브라우저 네트워크 탭에도 안 보인다). 이 값이 쓰이는 곳은 로그인 후 장바구니처럼
# 사용자마다 달라지는 요청뿐이다.
#
# 비워 두면 http://localhost:8080 으로 떨어진다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 절대 URL 생성용 (OG 태그, 사이트맵). 운영은 https://hanseongge.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 관리자 화면 귀퉁이에 뜨는 환경 표시. local / dev / prod
NEXT_PUBLIC_ENV_LABEL=local

# ---------------------------------------------------------------------
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 박혀 나간다.
#    비밀값(API 키·시크릿)에는 절대 이 접두사를 쓰지 않는다.
# ---------------------------------------------------------------------

# 네이버 지도 (NCP Maps > Application > Client ID).
#
# Client Secret 은 쓰지 않는다. 지도와 지오코딩을 모두 브라우저 JS SDK
# (maps.js?ncpKeyId=...&submodules=geocoder) 로 처리하기 때문이다. 이 방식은
# 키를 URL 허용목록으로 보호하므로 시크릿 자체가 존재할 자리가 없다.
# 서버용 REST Geocoding API 를 쓰게 되면 그때는 시크릿이 필요하고, 그 값은
# NEXT_PUBLIC_ 이 아니라 백엔드 환경변수로 들어가야 한다.
#
# 비워 두면 지점 페이지가 지도 대신 "네이버 지도에서 보기" 링크를 보여준다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
