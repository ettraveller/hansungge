# =====================================================================
# 프론트엔드 운영 빌드 값
#
#   cp .env.production.example .env.production
#
# ⚠️ 이 파일이 없으면 운영 번들이 localhost 를 부른다.
#
# NEXT_PUBLIC_* 는 런타임이 아니라 <b>빌드 시점</b>에 번들에 박힌다. 서버의
# /etc/hanseongge/web.env 에 적어도 소용이 없다 — deploy.sh 가 개발 PC 에서
# `npm run build` 를 돌리므로, 그때 이 파일이 있어야 운영 주소가 들어간다.
#
# 값 자체는 비밀이 아니다(브라우저 번들에 그대로 보인다). 그런데도 .gitignore
# 대상인 이유는 도메인·키가 확정되기 전에 잘못된 값이 커밋되어 굳는 것을 막기
# 위해서다. 무엇이 필요한지는 이 .example 이 알려준다.
# =====================================================================

# 브라우저와 서버 컴포넌트가 함께 쓰는 백엔드 주소.
# nginx 가 api 서브도메인을 8080 으로 넘긴다.
NEXT_PUBLIC_API_BASE_URL=https://api.hanseongge.com

# 절대 URL 생성용 (OG 태그, 사이트맵)
NEXT_PUBLIC_SITE_URL=https://hanseongge.com

# 관리자 화면 귀퉁이 환경 표시
NEXT_PUBLIC_ENV_LABEL=prod

# 네이버 지도 (TODO E-3). 없으면 지점 페이지가 지도 대신 안내 문구를 보여준다 —
# 임의의 기본 좌표로 지도를 띄우지 않는다. 틀린 위치를 맞다고 믿는 것이 더 나쁘다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
