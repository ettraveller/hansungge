# =====================================================================
# 백엔드 환경변수 템플릿
#
#   로컬  : cp .env.example .env  후 값 채우기 (IDE 의 EnvFile 플러그인 또는 셸에서 export)
#   운영  : /etc/hanseongge/api.env  (root:root, 권한 600) 로 배치하고
#           systemd 유닛의 EnvironmentFile 로 주입한다.
#
# 이 파일에는 실제 값을 넣지 않는다. 값이 채워진 .env 는 .gitignore 대상이다.
# =====================================================================

# --- 프로파일 (local / dev / prod) ---
SPRING_PROFILES_ACTIVE=local

# --- 최초 관리자 부트스트랩 ---
# admin_users 가 비어 있을 때만 SUPER_ADMIN 1개를 생성한다.
# 값이 없으면 생성을 건너뛰고 WARN 을 남긴다 (기본 계정을 코드에 박지 않기 위함).
# 최초 로그인 후 비밀번호를 변경하고 이 변수는 제거할 것.
ADMIN_INIT_ID=
ADMIN_INIT_PASSWORD=

# --- 데이터베이스 (필수) ---
DB_URL=jdbc:postgresql://localhost:5432/hanseongge
DB_USERNAME=hanseongge
DB_PASSWORD=
DB_POOL_SIZE=10

# --- 서버 ---
SERVER_PORT=8080
# 운영에서는 Nginx 만 바라보므로 루프백 바인딩
# SERVER_ADDRESS=127.0.0.1
# MANAGEMENT_PORT=8081

# --- CORS (콤마 구분) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- API 문서 (운영은 반드시 false) ---
SWAGGER_ENABLED=true

# --- 로그 ---
# LOG_PATH=/var/log/hanseongge

# --- JWT (STEP 5, 관리자 토큰) ---
# 최소 32바이트(256bit) 랜덤. 운영/개발 값을 반드시 다르게 둔다.
# 비워 두면 local/dev 는 1회용 랜덤 키로 뜨고(재기동 시 전원 로그아웃), prod 는 기동 실패한다.
#   생성 예: openssl rand -base64 48
JWT_SECRET=
JWT_ADMIN_ACCESS_TTL_MINUTES=30
JWT_ADMIN_REFRESH_TTL_HOURS=8

# --- 관리자 로그인 보호 (STEP 5) ---
ADMIN_MAX_LOGIN_FAILURES=5
ADMIN_LOGIN_RATE_PER_MINUTE=10

# =====================================================================
# 아래는 STEP 6 이후 추가된다. 지금은 비워 둔다.
# =====================================================================

# --- 사용자 JWT (STEP 6) ---
# JWT_USER_ACCESS_TTL_MINUTES=30
# JWT_USER_REFRESH_TTL_DAYS=14

# --- OAuth2 (STEP 5) ---
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_NAVER_CLIENT_ID=
# OAUTH_NAVER_CLIENT_SECRET=
# OAUTH_KAKAO_CLIENT_ID=
# OAUTH_KAKAO_CLIENT_SECRET=

# --- PG 결제 (STEP 14, TODO A-3 계약 후) ---
# PG_API_KEY=
# PG_SECRET_KEY=
# PG_WEBHOOK_SECRET=

# --- NCP Object Storage (STEP 10) ---
# NCP_STORAGE_ENDPOINT=
# NCP_STORAGE_BUCKET=
# NCP_ACCESS_KEY=
# NCP_SECRET_KEY=
