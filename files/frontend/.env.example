# =====================================================================
# 프론트엔드 환경변수 템플릿
#
#   cp .env.example .env.local
#
# 실제 값이 담긴 .env.local 은 .gitignore 대상이다.
# 무엇이 필요한지는 커밋하고, 값은 커밋하지 않는다.
# =====================================================================

# 브라우저가 직접 부를 백엔드 주소.
#
# 목록·상세 같은 공개 데이터는 서버 컴포넌트가 백엔드를 직접 부르므로 이 값을 쓰지
# 않는다(브라우저 네트워크 탭에도 안 보인다). 이 값이 쓰이는 곳은 로그인 후 장바구니처럼
# 사용자마다 달라지는 요청뿐이다.
#
# 비워 두면 http://localhost:8080 으로 떨어진다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 절대 URL 생성용 (OG 태그, 사이트맵). 운영은 https://hanseongge.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 관리자 화면 귀퉁이에 뜨는 환경 표시. local / dev / prod
NEXT_PUBLIC_ENV_LABEL=local

# ---------------------------------------------------------------------
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 박혀 나간다.
#    비밀값(API 키·시크릿)에는 절대 이 접두사를 쓰지 않는다.
# ---------------------------------------------------------------------
