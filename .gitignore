# =====================================================================
# 한성금거래소 모노레포 공통 .gitignore
# 최우선 규칙: 비밀값이 담긴 파일은 어떤 경우에도 커밋하지 않는다.
# =====================================================================

# --- 비밀값 (절대 커밋 금지) ---
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.development
!.env.production
!.env.local.example
secrets/
*.pem
*.key
*.p12
*.jks

# --- Java / Gradle ---
build/
.gradle/
!gradle/wrapper/gradle-wrapper.jar
out/
*.class
*.jar
!gradle-wrapper.jar
*.log

# --- Node / Next.js ---
node_modules/
.next/
next-env.d.ts
.turbo/
*.tsbuildinfo

# --- IDE ---
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- 배포 산출물 ---
dist/
releases/

# --- 초기 전달용 압축본 ---
# 예전에는 files/ 아래에 같은 내용이 풀려 있었다. 지금은 그 한 겹을 없앴다.
files.zip

# --- Claude Code 로컬 권한 설정 ---
# 개발자마다 다르므로 스킬은 추적하되 이 파일은 제외한다.
.claude/settings.local.json

# --- 외부로 보낼 문서 ---
# PG·관청에 보내는 회신문에는 심사용 계정 비밀번호 같은 값이 들어간다.
# 코드 저장소에 둘 이유가 없고, 한 번 올리면 지워도 커밋 기록에 남는다.
/토스페이먼츠_회신.txt
